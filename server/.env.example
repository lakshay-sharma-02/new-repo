# Copy to .env and adjust
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Serve the built client (/client/dist) from this process (single-container deploy)
SERVE_CLIENT=false
# CLIENT_DIST=../client/dist

# Demo mode uses the in-memory store (no MongoDB needed)
MOCK_MODE=true
JWT_SECRET=your-secret-key-here

# Access tokens are short-lived; refresh tokens rotate in an httpOnly cookie
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# lax for same-origin, none when the API is on a different site (requires HTTPS)
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: block checkout until the account verifies its email
REQUIRE_VERIFIED_EMAIL=false

# Only needed when MOCK_MODE=false
# MONGODB_URI=mongodb://localhost:27017/laundry-roulette
